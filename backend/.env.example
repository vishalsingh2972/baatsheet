# Server Port (Render sets this dynamically)
PORT=5000

# Environment (development | production)
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.lw2vc.mongodb.net/google-form?retryWrites=true&w=majority&appName=Cluster0

# Frontend Client URL (e.g. Vercel deployment URL or comma-separated URLs)
CLIENT_URL=https://your-frontend-app.vercel.app

# JWT Authentication Config
JWT_SECRET=your_super_secure_jwt_secret_key_123456
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
